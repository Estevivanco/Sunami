{
  "name": "sunami",
  "version": "1.0.0",
  "description": "Music App with MongoDB Atlas",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:models": "vitest run tests/unit/models",
    "test:repos": "vitest run tests/unit/repositories",
    "test:controllers": "vitest run tests/integration/controllers",
    "test:coverage": "vitest run --coverage",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed": "node scripts/seedFromJson.js",
    "generate:secrets": "node scripts/generateSecrets.js",
    "seed:playlists": "node scripts/createCuratedPlaylists.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.0",
    "vitest": "^4.1.4"
  }
